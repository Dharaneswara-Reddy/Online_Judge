@startuml DurableExecutionEngine
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 50
skinparam class {
    BackgroundColor<<Domain>> #FFF2CC
    BorderColor<<Domain>> #BF9000
    BackgroundColor<<Engine>> #D9E2F3
    BorderColor<<Engine>> #4472C4
    BackgroundColor<<Idempotency>> #FCE4D6
    BorderColor<<Idempotency>> #C55A11
    BackgroundColor<<Sharding>> #F3E9F9
    BorderColor<<Sharding>> #7030A0
    BackgroundColor<<Worker>> #E2EFDA
    BorderColor<<Worker>> #548235
}
title Distributed Durable Execution Engine — Detailed Class Diagram

' ===================== DOMAIN LAYER =====================
package "Domain Layer (Workflow Definitions)" {
    interface Workflow <<Domain>> {
        + Execute(ctx: WorkflowContext): error
        + GetIdempotencyMode(): IdempotencyMode
    }

    class FoodDeliveryOrderWorkflow <<Domain>> {
        - orderID: string
        - amount: float64
        + Execute(ctx: WorkflowContext): error
    }

    class AIAgentPipelineWorkflow <<Domain>> {
        - goal: string
        - llmModel: string
        + Execute(ctx: WorkflowContext): error
    }

    interface Activity <<Domain>> {
        + Execute(args: Map): (Result, error)
        + GetIdempotencyMode(): IdempotencyMode
    }
}

Workflow <|.. FoodDeliveryOrderWorkflow
Workflow <|.. AIAgentPipelineWorkflow

' ===================== ENGINE CORE =====================
package "Engine Core" {
    interface WorkflowContext <<Engine>> {
        + ExecuteActivity(name: string, args: Map): Future
        + Sleep(duration: Duration): void
        + WaitForSignal(name: string): any
        + Now(): Time
    }

    abstract class Event <<Engine>> {
        + eventID: string
        + workflowID: string
        + sequenceNum: int
        + timestamp: Time
    }

    class WorkflowStartedEvent <<Engine>>
    class ActivityScheduledEvent <<Engine>> {
        + activityName: string
        + args: Map
    }
    class ActivityCompletedEvent <<Engine>> {
        + result: any
    }
    class ActivityFailedEvent <<Engine>> {
        + errorMsg: string
    }
    class TimerFiredEvent <<Engine>> {
        + timerID: string
    }
    class WorkflowCompletedEvent <<Engine>>

    class EventLog <<Engine>> {
        - workflowID: string
        + Append(e: Event): error
        + Replay(workflowID: string): List<Event>
    }

    class WorkflowExecution <<Engine>> {
        - workflowID: string
        - status: ExecutionStatus
        + GetHistory(): List<Event>
        + Resume(): void
    }
}

Event <|-- WorkflowStartedEvent
Event <|-- ActivityScheduledEvent
Event <|-- ActivityCompletedEvent
Event <|-- ActivityFailedEvent
Event <|-- TimerFiredEvent
Event <|-- WorkflowCompletedEvent

EventLog "1" *-- "0..*" Event : appends >
WorkflowExecution "1" o-- "1" EventLog : replays from >
FoodDeliveryOrderWorkflow ..> WorkflowContext : uses
AIAgentPipelineWorkflow ..> WorkflowContext : uses
WorkflowContext ..> Activity : schedules >

' ===================== IDEMPOTENCY LAYER =====================
package "Idempotency Layer" {
    interface IdempotencyChecker <<Idempotency>> {
        + IsDuplicate(call: ActivityCall): bool
    }

    class ExactMatchChecker <<Idempotency>> {
        + IsDuplicate(call: ActivityCall): bool
        - hash(call: ActivityCall): string
    }

    class SemanticMatchChecker <<Idempotency>> {
        - threshold: float64
        + IsDuplicate(call: ActivityCall): bool
    }

    class EmbeddingService <<Idempotency>> {
        + Embed(text: string): Vector
        + CosineSimilarity(a: Vector, b: Vector): float64
    }
}

IdempotencyChecker <|.. ExactMatchChecker
IdempotencyChecker <|.. SemanticMatchChecker
SemanticMatchChecker "1" --> "1" EmbeddingService : uses >

' ===================== SHARDING & COORDINATION =====================
package "Sharding & Coordination" {
    class ConsistentHashRing <<Sharding>> {
        - virtualNodes: int
        + AddNode(nodeID: string): void
        + RemoveNode(nodeID: string): void
        + GetShardFor(workflowID: string): Shard
    }

    class Shard <<Sharding>> {
        - shardID: int
        - hashRange: Range
        + GetOwner(): NodeID
    }

    class LeaseTable <<Sharding>> {
        - fencingToken: int64
        + AcquireLease(nodeID: string): bool
        + RenewLease(nodeID: string): bool
        + IsExpired(): bool
    }

    class TaskQueue <<Sharding>> {
        + Enqueue(t: Task): void
        + Poll(): Task
    }

    class Replica <<Sharding>> {
        - shardID: int
        - lagMs: int
        + SyncFromPrimary(): void
        + PromoteToPrimary(): void
    }

    class Gateway <<Sharding>> {
        + RouteRequest(workflowID: string): Shard
    }
}

Gateway "1" --> "1" ConsistentHashRing : uses >
ConsistentHashRing "1" --> "0..*" Shard : maps to >
Shard "1" *-- "1" EventLog : owns
Shard "1" *-- "1" LeaseTable : owns
Shard "1" *-- "1" TaskQueue : owns
Shard "1" --> "0..1" Replica : replicates to >

' ===================== WORKER LAYER =====================
package "Worker Pool" {
    class WorkerPool <<Worker>> {
        + Start(): void
        + Stop(): void
    }

    class WorkflowWorker <<Worker>> {
        + ReplayAndAdvance(workflowID: string): void
    }

    class ActivityWorker <<Worker>> {
        - retryPolicy: RetryPolicy
        + ExecuteActivity(a: Activity): (Result, error)
    }

    class TimerService <<Worker>> {
        + ScheduleTimer(workflowID: string, dur: Duration): void
        + FireDueTimers(): void
    }

    class SagaManager <<Worker>> {
        + RegisterCompensation(step: string, comp: Activity): void
        + Rollback(workflowID: string): void
    }
}

WorkerPool "1" *-- "0..*" WorkflowWorker
WorkerPool "1" *-- "0..*" ActivityWorker
TaskQueue "1" --> "0..*" WorkflowWorker : polled by >
TaskQueue "1" --> "0..*" ActivityWorker : polled by >
WorkflowWorker "1" --> "1" EventLog : replays >
WorkflowWorker "1" --> "1" TimerService : schedules via >
WorkflowWorker "1" --> "1" SagaManager : triggers via >
ActivityWorker "1" --> "1" IdempotencyChecker : checks via >
SagaManager ..> Activity : runs compensating >

@enduml