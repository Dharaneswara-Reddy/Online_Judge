# Environment variables and secrets.
#
# A bare `.env` matched only that exact name, so every variant walked
# straight past it: `.env.local`, `.env.production`, and `server/.env.test`,
# which the Go test suite now reads for its MongoDB URI. Ignore the whole
# family, then re-admit committed templates by name — that way adding a new
# environment never depends on remembering to extend this list.
.env
.env.*
*.env

# Templates are documentation, not secrets, and are meant to be committed.
!.env.example
!.env.*.example
!.env.sample
!.env.template

# Go
# Compiled binaries only. These patterns are anchored with a leading
# slash on purpose: an unanchored "api" also matches client/src/api/,
# which silently kept the whole frontend API layer out of the repository.
/server/tmp/
/server/api
/api
*.exe
*.out

# Node / React
node_modules/
dist/
.vite/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# PDF (design doc — not source code)
*.pdf

# AI / agent tooling
CLAUDE.md
.agent/
.claude/
.claude-*/
.cursor/
.aider*
.windsurfrules
.github/copilot-instructions.md
AGENTS.md
GEMINI.md
.mcp.json

# Production deployment secrets (host-only)
deploy/.env
deploy/*.pem
*.pem

# graphify knowledge-graph output (local context, not project source)
graphify-out/
