# CodeArena API configuration.
#
# Copy to server/.env and fill in. That file is git-ignored; this one is
# the tracked template, so never put a real credential here.

# ── Required ──────────────────────────────────────────────────────────
# The API refuses to start without these.
MONGO_URI=mongodb://localhost:27017
JWT_SECRET=change-me-to-at-least-32-random-characters-openssl-rand-base64-48

# ── Core, with sane defaults ──────────────────────────────────────────
DB_NAME=online_judge
PORT=8080
CLIENT_URL=http://localhost:5173

# Marks the session cookie Secure. Defaults to true when CLIENT_URL is
# https, so local development over plain HTTP needs this set to false.
SECURE_COOKIES=false

# ── Optional infrastructure ───────────────────────────────────────────
# Both are optional by design: with no broker the API judges inline, and
# with no Redis there is no cross-instance fan-out and no rate limiting.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
REDIS_URL=redis://localhost:6379/0

# Queue prefetch, and the hard ceiling on judge containers alive at once.
# MAX_SANDBOXES is deliberately separate from WORKER_COUNT: a worker runs
# three consumers, so sizing containers from the prefetch tripled them.
WORKER_COUNT=4
MAX_SANDBOXES=1

# ── AI assistant (optional) ───────────────────────────────────────────
# With no key the assist endpoints answer 503, the client hides the
# feature, and nothing else in the API changes.
#
# Groq is the primary provider and wins when both keys are present, so a
# box holding both is not silently billed for the metered one.
GROQ_API_KEY=

# The model. Free-tier identifiers are retired on a schedule, so treat
# this as the real setting rather than trusting the built-in default.
# Default: openai/gpt-oss-120b
ASSIST_MODEL=openai/gpt-oss-120b

# Kill switch, independent of every credential. Set false to turn the
# assistant off without deleting a key.
ASSIST_ENABLED=true

# Point at any other OpenAI-compatible endpoint — Together, OpenRouter,
# a local llama.cpp or vLLM server. Leave empty for Groq.
ASSIST_BASE_URL=

# Fallback provider, consulted only when GROQ_API_KEY is empty.
ANTHROPIC_API_KEY=
